{
  "name": "gem-rush",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time multiplayer top-down arena collection game. Peer-hosted, browser only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r typecheck && pnpm --filter @gem-rush/client build && pnpm --filter gem-rush build",
    "dev": "pnpm --filter @gem-rush/client dev",
    "host": "pnpm --filter gem-rush start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @gem-rush/shared test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim:bench": "node --experimental-strip-types packages/server/src/bench.ts",
    "host:dist": "pnpm --filter gem-rush serve:dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
