{
  "name": "squad-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time multiplayer top-down arena collection game. Peer-hosted, browser only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r typecheck && pnpm --filter @squad-arena/client build",
    "dev": "pnpm --filter @squad-arena/client dev",
    "host": "pnpm --filter @squad-arena/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @squad-arena/shared test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
