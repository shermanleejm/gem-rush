{
  "name": "gem-rush",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "gem-rush": "./dist/index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "serve:dist": "node dist/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@gem-rush/shared": "workspace:*",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.12"
  },
  "description": "Peer-hosted browser multiplayer arena game. One command to host, friends join by URL.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "game",
    "multiplayer",
    "browser",
    "websocket",
    "self-hosted"
  ]
}
